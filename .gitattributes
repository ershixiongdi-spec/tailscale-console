# 锁死换行符，避免跨平台协作/下载 zip 时脚本跑不起来
# .sh 必须是 LF —— 否则 macOS 报 "bad interpreter: /bin/bash^M"
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
# Windows 批处理反而必须是 CRLF
*.bat  text eol=crlf
# 二进制，别做换行转换
*.ico  binary
*.icns binary
*.png  binary
